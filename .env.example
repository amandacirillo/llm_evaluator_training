# llm_evaluator — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# The environment holds ONLY the proxy secret + endpoint. All other tunables
# (checklist/critic model, judge council, backup judge, sample count N, and the
# compared-model temperature) live in config/evaluator.json — see that file.

# ── LiteLLM proxy (OpenAI-compatible) ──────────────────────────────────
# Required. The proxy URL your key talks to, e.g. https://litellm.example.com
# (include the version suffix if your proxy uses one, e.g. .../v1)
LITELLM_API_BASE=https://litellm.example.com

# Required. Your LiteLLM key (sk-...). Stays server-side; never sent to the browser.
LITELLM_API_KEY=sk-your-key-here
